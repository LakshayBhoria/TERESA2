# Set these in Vercel > Project > Settings > Environment Variables (never commit a real .env)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# 32+ random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Used only to create the first admin when the users table is empty
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional: login session length in hours (default 12, max 168)
SESSION_HOURS=12
